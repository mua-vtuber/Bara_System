[Unit]
Description=Bara Memory API (apps/memory) — 코어 모듈
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=bara
WorkingDirectory=/home/bara/bara_system/apps/memory
# 첫 부팅 시 data/ 디렉토리 자동 생성 — SQLite 빈 DB 파일 저장 위치 확보.
ExecStartPre=/bin/mkdir -p /home/bara/bara_system/apps/memory/data
ExecStart=/home/bara/.bun/bin/bun run src/index.ts
Environment=TZ=Asia/Seoul
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

# 첫 부팅 시 임베딩 모델 로드 1~2분 — start timeout 넉넉히
TimeoutStartSec=180

# P4 D3-c — 종료 대기 상한. 초과 시 SIGKILL — WAL+NORMAL 이라 커밋된 트랜잭션은
# 무손실(유실은 정전·OS crash 한정). 실비용 = 진행 중 추출 사이클 재작업 가능.
TimeoutStopSec=180

[Install]
WantedBy=multi-user.target
