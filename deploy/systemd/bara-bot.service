[Unit]
Description=Bara Discord Bot (apps/bot-discord) — 어댑터
After=network.target bara-memory.service
Wants=bara-memory.service

[Service]
Type=simple
User=bara
WorkingDirectory=/home/bara/bara_system/apps/bot-discord
# 첫 부팅 시 data/ 디렉토리 자동 생성 — bot-settings.json 저장 위치 확보.
ExecStartPre=/bin/mkdir -p /home/bara/bara_system/apps/bot-discord/data
ExecStart=/home/bara/.bun/bin/bun run src/index.ts
Environment=TZ=Asia/Seoul
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
