{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bara",
  "version": "0.1.0",
  "identifier": "app.bara.launcher",
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "bun run build:frontend",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Bara",
        "width": 520,
        "height": 360,
        "resizable": false,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": ["icons/icon.ico"],
    "resources": []
  }
}
