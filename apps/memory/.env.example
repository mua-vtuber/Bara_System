# memory-api
MEMORY_HOST=127.0.0.1
MEMORY_PORT=3001
MEMORY_DB_PATH=../../data/bara.sqlite
MEMORY_SETTINGS_PATH=../../data/memory-settings.json
BARA_ASSET_DIR=../../data/assets
SSE_TOKEN_PATH=../../data/sse-tokens.json

# OCR companion client
# BARA_MEMORY_URL is preferred. MEMORY_API_URL is also accepted for compatibility.
BARA_MEMORY_URL=http://127.0.0.1:3001
MEMORY_API_URL=http://127.0.0.1:3001
BARA_MEMORY_TOKEN=
BARA_OCR_WORKER_ID=pc-ocr
BARA_OCR_POLL_SECONDS=30
BARA_OCR_LEASE_SECONDS=1800
BARA_OCR_TMP_DIR=
BARA_OCR_PROVIDER_NAME=document-ocr-companion

# The companion also accepts a command after `--`; that CLI command has priority.
# Placeholders: {input}, {output}, {documentId}
BARA_OCR_COMMAND_JSON=["python","/path/to/ocr.py","{input}","{output}","{documentId}"]
